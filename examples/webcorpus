MAINTAINER "indig.balazs@btk.elte.hu"
INFO "Webcorpus 2.0"
NAME "Webcorpus 2.0"
PATH webcorpus
ENCODING "UTF-8"
LANGUAGE "Hungarian"

PATH "/corpora/webcorpus/indexed/"

# Stabilise the ordering of files
VERTICAL "| LC_ALL=C gzip -cd /corpora/webcorpus/vertical/ske_*.tsv.gz"

INFOHREF "https://hlt.bme.hu/hu/resources/webcorpus2"
TAGSETDOC "https://e-magyar.hu/hu/textmodules/emmorph_codelist"

# Display structural attributes before concordance lines
SHORTREF "=doc.id,=p.id,=s.id"

ATTRIBUTE word {
    TYPE "FD_FGD"
}

ATTRIBUTE lemma {
    TYPE "FD_FGD"
}

ATTRIBUTE tag {
    TYPE "FD_FGD"
}

ATTRIBUTE np {
    TYPE "FD_FGD"
}

ATTRIBUTE deep {
    TYPE "FD_FGD"
}

ATTRIBUTE surface {
    TYPE "FD_FGD"
}

ATTRIBUTE morphtags {
    TYPE "FD_FGD"
}

ATTRIBUTE lc {
    LABEL      "word (lowercase)"
    DYNAMIC    utf8lowercase
    DYNLIB     internal
    ARG1       "C"
    FUNTYPE    s
    FROMATTR   word
    TYPE       index
    TRANSQUERY yes
}

ATTRIBUTE lemma_lc {
    LABEL      "lemma (lowercase)"
    DYNAMIC    utf8lowercase
    DYNLIB     internal
    ARG1       "C"
    FUNTYPE    s
    FROMATTR   lemma
    TYPE       index
    TRANSQUERY yes
}

STRUCTURE doc {
    ATTRIBUTE "id"
    ATTRIBUTE "name"
    ATTRIBUTE "domain"
    TYPE      "file64"
    ATTRIBUTE "wordcount"
}

STRUCTURE p {
    ATTRIBUTE "id"
    TYPE      "file64"
}

STRUCTURE s {
    ATTRIBUTE "id"
    TYPE      "file64"
}

STRUCTURE g {
    DISPLAYTAG   0
    DISPLAYBEGIN "_EMPTY_"
    TYPE         "file64"
}
